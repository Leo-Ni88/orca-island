{
  "$schema": "https://orca.dev/schemas/orca-plugin.schema.json",
  "manifestVersion": 2,
  "id": "agent-island",
  "publisher": "leo-ni88",
  "name": "Orca Island",
  "version": "1.0.0",
  "description": "A notch-style island for Orca on macOS: see which agents need you, finished or failed at a glance, and jump straight to them.",
  "author": {
    "name": "Leo-Ni88",
    "url": "https://github.com/Leo-Ni88"
  },
  "repository": "https://github.com/Leo-Ni88/orca-island",
  "homepage": "https://github.com/Leo-Ni88/orca-island",
  "license": "MIT",
  "icon": "media/icon.png",
  "cover": {
    "path": "media/cover.png",
    "alt": "Orca Island over a desktop: a prompt that needs you"
  },
  "screenshots": [
    {
      "path": "media/screenshots/peek.png",
      "alt": "A prompt that needs you peeks from the top of the screen"
    },
    {
      "path": "media/screenshots/list-project.png",
      "alt": "The list, grouped by project"
    },
    {
      "path": "media/screenshots/list-bot.png",
      "alt": "The list, grouped by bot"
    },
    {
      "path": "media/screenshots/detail-prompt.png",
      "alt": "A terminal prompt with its options and a reply field"
    },
    {
      "path": "media/screenshots/detail-bot.png",
      "alt": "A bot item with two questions"
    },
    {
      "path": "media/screenshots/settings.png",
      "alt": "Settings: answering is off by default"
    }
  ],
  "engines": {
    "orca": ">=1.4.259"
  },
  "execution": "trusted-worker",
  "pluginApi": 1,
  "main": "src/worker.ts",
  "capabilities": [
    {
      "kind": "agent:read"
    },
    {
      "kind": "workspace:read"
    },
    {
      "kind": "workspace:write"
    },
    {
      "kind": "notifications:show"
    },
    {
      "kind": "storage:own"
    },
    {
      "kind": "settings:own"
    },
    {
      "kind": "terminal:read"
    },
    {
      "kind": "terminal:send"
    }
  ],
  "contributes": {
    "events": [
      {
        "on": "agent.status.changed"
      },
      {
        "on": "workspace.created"
      },
      {
        "on": "workspace.removed"
      },
      {
        "on": "workspace.changed"
      }
    ],
    "commands": [
      {
        "id": "island.dump",
        "title": "Orca Island: Dump recorded events"
      },
      {
        "id": "island.clear",
        "title": "Orca Island: Clear recorded events"
      },
      {
        "id": "island.probe",
        "title": "Orca Island: Probe agents.list / workspace.list"
      },
      {
        "id": "island.helper.status",
        "title": "Orca Island: Helper status and round-trip test"
      },
      {
        "id": "island.helper.restart",
        "title": "Orca Island: Restart helper"
      },
      {
        "id": "island.test",
        "title": "Orca Island: Push a test item to the island"
      },
      {
        "id": "island.statusClick",
        "title": "Orca Island: Status bar pressed"
      },
      {
        "id": "island.power",
        "title": "Orca Island: Turn the island off for 1 hour"
      }
    ],
    "statusBarItems": [
      {
        "id": "island-summary",
        "text": "Island",
        "icon": "bell",
        "tone": "neutral",
        "tooltip": "Orca Island",
        "command": "island.statusClick"
      },
      {
        "id": "island-power",
        "text": "",
        "icon": "pause",
        "tone": "neutral",
        "tooltip": "Turn Orca Island off for 1 hour",
        "command": "island.power"
      }
    ],
    "settings": [
      {
        "key": "enabled",
        "title": "启用 Orca Island",
        "description": "关闭后不显示 Island、不发提醒、不读写终端，但仍在后台记录状态。在 Orca 状态栏点「Island 已关闭」也可以重新打开。",
        "type": "boolean",
        "default": true
      },
      {
        "key": "helper",
        "title": "Island 程序",
        "description": "用哪个原生程序绘制 Island。",
        "type": "string",
        "default": "swift",
        "enum": [
          "swift",
          "jxa",
          "off"
        ],
        "enumLabels": [
          "Swift 程序",
          "JXA（osascript）",
          "关闭"
        ]
      },
      {
        "key": "record",
        "title": "记录事件",
        "description": "把每个 agent 和工作区事件写入插件存储，用于排查问题。",
        "type": "boolean",
        "default": false
      },
      {
        "key": "preset",
        "title": "提醒强度",
        "description": "提醒多少：安静只提醒需要你和失败，标准，全部。",
        "type": "string",
        "default": "standard",
        "enum": [
          "quiet",
          "standard",
          "all"
        ],
        "enumLabels": [
          "安静",
          "标准",
          "全部"
        ]
      },
      {
        "key": "displayMode",
        "title": "显示位置",
        "description": "Island 画在哪里。",
        "type": "string",
        "default": "auto",
        "enum": [
          "auto",
          "pill",
          "menubar",
          "auto+menubar"
        ],
        "enumLabels": [
          "自动",
          "强制药丸",
          "仅菜单栏图标",
          "自动 + 菜单栏图标"
        ]
      },
      {
        "key": "sounds",
        "title": "声音",
        "description": "播放系统提示音。",
        "type": "boolean",
        "default": true
      },
      {
        "key": "systemNotifications",
        "title": "系统通知兜底",
        "description": "Island 程序不可用时改用系统通知。",
        "type": "boolean",
        "default": true
      },
      {
        "key": "minWorkSec",
        "title": "完成提醒的最短时长（秒）",
        "description": "比这更短的任务完成时不提醒。",
        "type": "integer",
        "default": 20,
        "minimum": 0,
        "maximum": 3600
      },
      {
        "key": "hotkey",
        "title": "全局快捷键 ⌃⌥⇧U",
        "description": "跳到下一条需要你处理的会话。",
        "type": "boolean",
        "default": true
      },
      {
        "key": "hideFromCapture",
        "title": "录屏和截图时隐藏",
        "description": "尽力而为，部分录屏工具仍可能拍到。",
        "type": "boolean",
        "default": true
      },
      {
        "key": "orcaSource",
        "title": "显示 Orca 的待你决定",
        "description": "通过 orca 命令行读取 bot 的问题、插件授权、失败的自动化和编排关卡。",
        "type": "boolean",
        "default": true
      },
      {
        "key": "orcaCli",
        "title": "orca 命令行路径",
        "description": "留空时使用 ORCA_CLI_COMMAND，否则用 Orca.app 自带的。",
        "type": "string",
        "default": ""
      },
      {
        "key": "allowAnswer",
        "title": "允许在 Island 中直接回答",
        "description": "在 Island 里回答终端中 Claude Code 的提示。关闭时只读，不读取也不输入任何终端。",
        "type": "boolean",
        "default": false
      }
    ]
  }
}
